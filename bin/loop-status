#!/usr/bin/env python3
"""loop-status: a phone-sized, plain-English picture of a project's unattended build queue.

    loop-status [REPO]          REPO defaults to the git top folder of the current directory

Reads (never writes) REPO/.supervision/:
  QUEUE            task files, one per line, run in order by loop-queue (# comments allowed)
  status.conf      optional: TITLE, TASK_ID_REGEX, TMUX_SESSION, STOP_HINT and
                   LABEL.<ID>=Short name|One plain-English line   (see status.conf.example)
  loop.log         agy-loop's log ("all N steps APPROVED on <branch>", "step N: APPROVED" ...)
  loop-state.json  agy-loop's current task, step and attempt
  queue.log        loop-queue's notes (START, DONE, STOPPED, waiting)
  loop.lock / queue.lock   held while agy-loop / loop-queue run (checked without locking)

Boxes: ✅ step approved   🔨 building now   ⬜ waiting   🛑 stopped   ⏳ queue waiting to retry
Never crashes on missing files: it says what is missing instead.
"""
import datetime
import json
import os
import pathlib
import re
import subprocess
import sys

TS = re.compile(r"^\d{4}-\d\d-\d\d \d\d:\d\d:\d\d ")


def repo_root(arg):
    if arg:
        return pathlib.Path(arg).expanduser().resolve()
    try:
        out = subprocess.run(["git", "rev-parse", "--show-toplevel"], capture_output=True, text=True, check=True)
        return pathlib.Path(out.stdout.strip())
    except Exception:
        return pathlib.Path.cwd()


def read(path):
    try:
        return path.read_text(errors="ignore")
    except Exception:
        return ""


def parse_conf(text):
    """KEY=VALUE lines; '#' comments; LABEL.<ID>=name|line. Values are plain text, never executed."""
    conf, labels = {}, {}
    for raw in text.splitlines():
        line = raw.strip()
        if not line or line.startswith("#") or "=" not in line:
            continue
        key, value = (part.strip() for part in line.split("=", 1))
        if key.startswith("LABEL."):
            name, _, why = value.partition("|")
            labels[key[6:]] = (name.strip(), why.strip())
        else:
            conf[key] = value
    return conf, labels


def held(lock):
    """True if some process has the lock file open (agy-loop / loop-queue keep it open while running)."""
    try:
        target = str(lock.resolve())
    except Exception:
        return False
    if not lock.exists():
        return False
    for fd_dir in pathlib.Path("/proc").glob("[0-9]*/fd"):
        try:
            for fd in fd_dir.iterdir():
                try:
                    if os.readlink(fd) == target:
                        return True
                except OSError:
                    continue
        except OSError:
            continue
    return False


def ts(line):
    return datetime.datetime.strptime(line[:19], "%Y-%m-%d %H:%M:%S").replace(tzinfo=datetime.timezone.utc)


def main(argv):
    if len(argv) > 1 and argv[1] in ("-h", "--help"):
        print(__doc__.strip())
        return 0
    repo = repo_root(argv[1] if len(argv) > 1 else None)
    sup = repo / ".supervision"
    conf, labels = parse_conf(read(sup / "status.conf"))
    title = conf.get("TITLE") or f"{repo.name} build"
    try:
        id_re = re.compile(conf.get("TASK_ID_REGEX") or r"[A-Z]+[0-9]+")
    except re.error:
        id_re = re.compile(r"[A-Z]+[0-9]+")
    session = conf.get("TMUX_SESSION") or repo.name
    stop_hint = conf.get("STOP_HINT") or f"Ask Claude: “fix the stopped {title} task”"
    now = datetime.datetime.now(datetime.timezone.utc)

    print(f"🧱 {title} · {now:%H:%M} UTC\n")
    if not sup.is_dir():
        print(f"No .supervision/ folder in {repo}. Nothing is set up to run yet.")
        return 0
    queue = sup / "QUEUE"
    if not queue.exists():
        print("No .supervision/QUEUE yet. Add task files to it, one per line, then start the queue.")
        return 0

    log = read(sup / "loop.log")
    try:
        state = json.loads(read(sup / "loop-state.json") or "{}")
    except Exception:
        state = {}
    building = held(sup / "loop.lock")
    runner = held(sup / "queue.lock")
    qnotes = [l for l in read(sup / "queue.log").splitlines() if TS.match(l)]

    current = None
    tasks = 0
    for line in read(queue).splitlines():
        task = line.strip()
        if not task or task.startswith("#"):
            continue
        tasks += 1
        path = repo / task
        m = id_re.search(pathlib.Path(task).name)
        tid = m.group(0) if m else pathlib.Path(task).stem
        name, why = labels.get(tid, (pathlib.Path(task).stem, ""))
        head = tid if name == tid else f"{tid} {name}"
        if not path.exists():
            print(f"{head}\n   ⚠️  task file missing: {task}")
            continue
        text = read(path)
        n = max(len(re.findall(r"^### Step \d+", text, re.M)), 1)
        bm = re.search(r"Branch `([^`]+)`", text)
        branch = bm.group(1) if bm else None
        if branch and re.search(rf"all \d+ steps APPROVED on {re.escape(branch)}$", log, re.M):
            boxes, note = "✅" * n, "done"
        elif state.get("task") == task:
            cur = min(max(int(state.get("step", 1) or 1), 1), n)
            mark = "🔨" if building else ("⏳" if runner else "🛑")
            boxes = "✅" * (cur - 1) + mark + "⬜" * (n - cur)
            note = f"step {cur}/{n}" + ("" if building else (" waiting to retry" if runner else " STOPPED"))
            current = (tid, cur, n, int(state.get("attempt", 1) or 1))
        else:
            boxes, note = "⬜" * n, "waiting"
        print(f"{head}\n   {boxes}  {note}" + (f"\n   “{why}”" if why else ""))
    if tasks == 0:
        print("The QUEUE is empty. Add task files to .supervision/QUEUE, one per line.")
    print("\n✅ done  🔨 building  ⬜ waiting  🛑 stopped  ⏳ retrying\n")

    last = [l for l in log.splitlines() if TS.match(l)]
    if current:
        tid, cur, n, att = current
        if building:
            phase = next((l for l in reversed(last) if f"step {cur}/{n} attempt" in l
                          or re.search(rf"step {cur}: (gate|review)", l)), None)
            mins = ""
            if phase:
                mins = f" for {int((now - ts(phase)).total_seconds() // 60)} min"
            checking = bool(phase and re.search(rf"step {cur}: (gate|review)", phase))
            doing = "checking it (tests + reviewer)" if checking else "writing code"
            print(f"Now: the robot is {doing} on {tid} step {cur}{mins}" + (f" (try {att})" if att > 1 else ""))
        elif runner:
            wait = next((l[20:] for l in reversed(qnotes) if re.search(r"retry|waiting", l, re.I)), "")
            print(f"Now: ⏳ the queue is waiting to retry {tid} step {cur}. {wait}".rstrip())
        else:
            print(f"Now: 🛑 stopped at {tid} step {cur}. {stop_hint}")
    elif building:
        print("Now: a build is running (starting up).")
    elif runner:
        print("Now: the queue is starting the next task.")
    else:
        print(f"Now: nothing running. Start: tmux new -d -s {session} loop-queue {repo}")
    for l in reversed(last):
        m = re.search(r"step (\d+): (APPROVED|CHANGES_REQUIRED|ESCALATE\w*)", l)
        if m:
            icon = {"APPROVED": "✅"}.get(m.group(2), "🔁" if m.group(2) == "CHANGES_REQUIRED" else "⚠️")
            print(f"Last check: {icon} step {m.group(1)} {m.group(2).replace('_', ' ').lower()} at {l[11:16]}")
            break
    print("📱 Your phone gets a ping when a task finishes or stops.")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
